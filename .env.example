# Copy to .env; set SECRET_KEY with: openssl rand -hex 32
SECRET_KEY=local-development-change-this-to-a-random-64-character-secret
POSTGRES_PASSWORD=tera-local-database-password
DATABASE_URL=postgresql+psycopg://tera:tera-local-database-password@postgres:5432/tera
REDIS_URL=redis://redis:6379/0
PUBLIC_URL=http://localhost:8080
ENVIRONMENT=development
COOKIE_SECURE=false
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
MAIL_FROM=TERA <no-reply@tera.local>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=tera-local
S3_SECRET_KEY=tera-local-storage-secret
S3_BUCKET=tera-evidence
MFA_REQUIRED_PRIVILEGED=false

# Speech Engine Configuration
SPEECH_PROVIDER=whisper
SPEECH_PROVIDER_API_KEY=
SPEECH_PROVIDER_REGION=
SPEECH_PROVIDER_LANGUAGE=en
SPEECH_PROVIDER_ENDPOINT=
RECORDINGS_DIR=/tmp/tera_recordings
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080,http://127.0.0.1:5173
