# TERA 2.0 Environment Configuration
# Production mode refuses to start with placeholder values.
# Set DEV_MODE=true ONLY for local development environments.
DEV_MODE=false
ENVIRONMENT=production
PUBLIC_URL=https://tera.example.com
COOKIE_SECURE=true

# Security Secrets (Must be unique, min 32-64 characters)
# Generate via: openssl rand -hex 32
SECRET_KEY=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://tera:<SECURE_PASSWORD>@postgres:5432/tera
REDIS_URL=redis://redis:6379/0

# Object Storage (MinIO / S3)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=tera-evidence

# Mail Server Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
MAIL_FROM=TERA Dispatch <no-reply@tera.example.com>

# Optional external providers. Never commit real credentials to Git.
SPEECH_PROVIDER=sarvam
SARVAM_API_KEY=
SARVAM_WEBHOOK_SECRET=
SPEECH_PROVIDER_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4.1-mini

# Public Bot / CAPTCHA Protection (none, turnstile, hcaptcha, pow)
CAPTCHA_PROVIDER=none
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# Routing & ETA Service (osrm, google, mapbox, straight_line)
ROUTING_PROVIDER=osrm
OSRM_URL=http://osrm:5000
GOOGLE_DIRECTIONS_API_KEY=
MAPBOX_ACCESS_TOKEN=
