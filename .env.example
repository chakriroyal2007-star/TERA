# Required for any shared or production deployment.
SECRET_KEY=replace-with-a-random-32-plus-character-secret
ENVIRONMENT=production
PUBLIC_URL=https://your-project.vercel.app
COOKIE_SECURE=true

# Use a persistent PostgreSQL database. Do not use Vercel's ephemeral /tmp
# SQLite fallback for operational data.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
REDIS_URL=redis://HOST:6379/0

# Speech-to-text: choose one provider and set its matching credential.
SPEECH_PROVIDER=sarvam
SARVAM_API_KEY=replace-with-a-newly-issued-sarvam-key
# Or: SPEECH_PROVIDER=whisper and SPEECH_PROVIDER_API_KEY=...

# Recommended for evidence uploads and outbound mail.
S3_ENDPOINT=https://your-s3-compatible-endpoint
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_BUCKET=tera-evidence
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
SMTP_TLS=true
MAIL_FROM=TERA <no-reply@example.com>
